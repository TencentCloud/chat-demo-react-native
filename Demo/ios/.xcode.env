#!/bin/sh
# React Native Xcode build environment
# —— v18.92 修复真机 build 报 Command PhaseScriptExecution failed 根因
# —— 现象：模拟器能装（react-native-xcode.sh 检测 PLATFORM_NAME=*simulator 直接 exit 0 跳过 bundle）
#         真机必须 bundle，触发 with-environment.sh → 找 .xcode.env → fallback command -v node
#         Xcode 启动的 /bin/sh 不读 .zshrc，nvm 的 node 不在 PATH → NODE_BINARY 为空
#         react-native-xcode.sh 找不到 node → bundle 失败 → PhaseScriptExecution failed
# —— 修：探测 PATH 里的 node；nvm 路径 fallback；个人用 .xcode.env.local 覆盖

# 优先取 PATH 里的 node
NODE_BINARY=$(command -v node 2>/dev/null)

# Fallback: nvm v20（user 当前主用版本）
if [ -z "$NODE_BINARY" ] && [ -f "$HOME/.nvm/versions/node/v20.18.2/bin/node" ]; then
  NODE_BINARY="$HOME/.nvm/versions/node/v20.18.2/bin/node"
fi

# Fallback: nvm v18（RN 0.74+ 备选）
if [ -z "$NODE_BINARY" ] && [ -f "$HOME/.nvm/versions/node/v18.20.4/bin/node" ]; then
  NODE_BINARY="$HOME/.nvm/versions/node/v18.20.4/bin/node"
fi

# Fallback: Homebrew node
if [ -z "$NODE_BINARY" ] && [ -f "/opt/homebrew/bin/node" ]; then
  NODE_BINARY="/opt/homebrew/bin/node"
fi

# Fallback: 系统 /usr/local/bin/node
if [ -z "$NODE_BINARY" ] && [ -f "/usr/local/bin/node" ]; then
  NODE_BINARY="/usr/local/bin/node"
fi

export NODE_BINARY
